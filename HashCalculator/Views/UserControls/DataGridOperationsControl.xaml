<UserControl
    x:Class="HashCalculator.Views.UserControls.DataGridOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:FilterOperationModel}"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <Border BorderThickness="0">
        <Border.IsEnabled>
            <MultiBinding Converter="{StaticResource CmdPanelCriticalControlsEnabledCvt}">
                <Binding Path="BatchStatus" Source="{x:Static pagemodels:HomeViewModel.Current}" />
                <Binding Path="IsFiltersAndCmdersIdle" Source="{x:Static local:Settings.Current}" />
            </MultiBinding>
        </Border.IsEnabled>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <!--  操作目标选择器命令  -->
            <ContentControl
                Grid.Row="0"
                Margin="-1,-1,0,0"
                Content="{Binding SelectTableLinesCmder.UserInterface}" />
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <wpfui:ListView
                        d:ItemsSource="{d:SampleData}"
                        ItemsSource="{Binding HashModelCmders}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedCmder, Mode=TwoWay}"
                        SelectionMode="Single">
                        <wpfui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Display}" />
                                    <wpfui:Flyout
                                        x:Name="eleFlyout"
                                        Grid.Column="0"
                                        Placement="Top">
                                        <TextBlock Text="{Binding Description}" TextWrapping="WrapWithOverflow" />
                                    </wpfui:Flyout>
                                    <Button
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.ShowDescriptionCmd}"
                                        CommandParameter="{Binding ElementName=eleFlyout}">
                                        <wpfui:SymbolIcon Symbol="QuestionCircle12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </wpfui:ListView.ItemTemplate>
                    </wpfui:ListView>
                </Border>
                <ScrollViewer
                    Grid.Column="1"
                    Margin="4,-1,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedCmder.UserInterface}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
