<UserControl
    x:Class="HashCalculator.Views.UserControls.DataGridFiltersControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:FilterOperationModel}"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <Border BorderThickness="0">
        <Border.IsEnabled>
            <MultiBinding Converter="{StaticResource CmdPanelCriticalControlsEnabledCvt}">
                <Binding Path="State" Source="{x:Static pagemodels:HomeViewModel.Current}" />
                <Binding Path="IsFiltersAndCmdersIdle" Source="{x:Static local:Settings.Current}" />
            </MultiBinding>
        </Border.IsEnabled>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <wpfui:Button
                    Grid.Row="1"
                    Appearance="Primary"
                    Command="{Binding RefreshFiltersCmd}"
                    CommandParameter="{StaticResource TrueValue}"
                    Content="刷新筛选"
                    Icon="{wpfui:SymbolIcon Symbol=ArrowSync16}"
                    ToolTip="应用已选择的筛选器并刷新主页视图。" />
                <wpfui:Button
                    Grid.Row="1"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Command="{Binding RefreshFiltersCmd}"
                    CommandParameter="{StaticResource FalseValue}"
                    Content="禁用筛选"
                    Icon="{wpfui:SymbolIcon Symbol=Dismiss12}"
                    ToolTip="取消应用已选择的筛选器并刷新主页视图。" />
                <wpfui:Button
                    Grid.Row="1"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Command="{Binding MoveFilterUpCmd}"
                    Content="上移所选"
                    Icon="{wpfui:SymbolIcon Symbol=ChevronUp12}"
                    ToolTip="上移筛选器..." />
                <wpfui:Button
                    Grid.Row="2"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Command="{Binding MoveFilterDownCmd}"
                    Content="下移所选"
                    Icon="{wpfui:SymbolIcon Symbol=ChevronDown12}"
                    ToolTip="下移筛选器..." />
                <wpfui:Button
                    Grid.Row="3"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Command="{Binding ClearFilterSelectionCmd}"
                    Content="清除选择"
                    Icon="{wpfui:SymbolIcon Symbol=Dismiss12}"
                    ToolTip="取消所有筛选器的启用状态..." />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <wpfui:ListView
                        d:ItemsSource="{d:SampleData}"
                        ItemsSource="{Binding HashModelFilters}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                        SelectionMode="Single">
                        <wpfui:ListView.ItemTemplate>
                            <DataTemplate>
                                <!--  使用 TextBlock 显示 Display 原因是防止一点列表项就自动勾选  -->
                                <StackPanel Margin="8,5" Orientation="Horizontal">
                                    <CheckBox
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding FilterChangedCmd}"
                                        IsChecked="{Binding Selected, Mode=TwoWay}"
                                        PreviewMouseDown="FiltersItemPreviewMouseDown"
                                        Style="{StaticResource NoMinCheckBoxStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                                </StackPanel>
                            </DataTemplate>
                        </wpfui:ListView.ItemTemplate>
                    </wpfui:ListView>
                </Border>
                <ScrollViewer
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,-1,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0" Content="{Binding SelectedFilter.UserInterface}" />
                        <wpfui:InfoBar
                            Title="{Binding SelectedFilter.Display}"
                            Grid.Row="1"
                            Margin="0,4,0,-1"
                            VerticalContentAlignment="Center"
                            IsOpen="{Binding IsInformationBarOpened, Mode=OneWay}"
                            Message="{Binding SelectedFilter.Description}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
