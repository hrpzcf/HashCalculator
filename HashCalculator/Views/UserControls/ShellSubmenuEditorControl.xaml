<UserControl
    x:Class="HashCalculator.Views.UserControls.ShellSubmenuEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:userctrlmodels="clr-namespace:HashCalculator.ViewModels.UserControls"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=userctrlmodels:HcCtxMenuModel}"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    Visibility="{Binding HasSubmenus, Converter={StaticResource TrueToVisibilityVisibleCvt}}"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Submenus}"
            SelectedItem="{Binding SelectedSubmenu}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="子菜单标题">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="算法">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                MinWidth="152"
                                ItemsSource="{Binding AvailableAlgTypes}"
                                SelectedItem="{Binding CurrentAlgoType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Padding="0,-1"
                                            Content="{Binding Display}"
                                            IsChecked="{Binding Selected}"
                                            Style="{StaticResource NoMinCheckBoxStyle}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <Button Command="{Binding AddSubmenuCmd}" Content="新建菜单" />
            <Button
                Margin="0,8,0,0"
                Command="{Binding MoveSubmenuUpCmd}"
                Content="上移所选" />
            <Button
                Margin="0,8,0,0"
                Command="{Binding MoveSubmenuDownCmd}"
                Content="下移所选" />
            <wpfui:Button
                Margin="0,32,0,0"
                Appearance="Danger"
                Command="{Binding DeleteSubmenuCmd}"
                Content="移除所选" />
        </StackPanel>
    </Grid>
</UserControl>
