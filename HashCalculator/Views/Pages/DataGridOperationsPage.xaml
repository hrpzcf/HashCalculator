<Page
    x:Class="HashCalculator.Views.Pages.DataGridOperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:FilterOperationModel}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
        <Border Padding="4" BorderThickness="0">
            <Border.IsEnabled>
                <MultiBinding Converter="{StaticResource CmdPanelCriticalControlsEnabledCvt}">
                    <Binding Path="State" Source="{x:Static pagemodels:HomeViewModel.Current}" />
                    <Binding Path="FilterAndCmderEnabled" Source="{x:Static local:Settings.Current}" />
                </MultiBinding>
            </Border.IsEnabled>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <wpfui:ListView
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    d:ItemsSource="{d:SampleData}"
                    ItemsSource="{Binding HashModelCmders}"
                    SelectedIndex="0"
                    SelectedItem="{Binding SelectedCmder}"
                    SelectionMode="Single">
                    <wpfui:ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="10,8"
                                Text="{Binding Display}"
                                ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </wpfui:ListView.ItemTemplate>
                </wpfui:ListView>
                <!--  操作目标选择器命令  -->
                <ContentControl
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="32,0,0,0"
                    Padding="16"
                    Content="{Binding SelectTableLinesCmder.UserInterface}" />
                <ContentControl
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="32,16,0,0"
                    Padding="16"
                    Content="{Binding SelectedCmder.UserInterface}" />
                <wpfui:InfoBar
                    Title="{Binding SelectedCmder.Display}"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="32,16,0,0"
                    VerticalContentAlignment="Center"
                    IsOpen="{Binding IsInformationBarOpened, Mode=OneWay}"
                    Message="{Binding SelectedCmder.Description}" />
            </Grid>
        </Border>
    </ScrollViewer>
</Page>
