<Page
    x:Class="HashCalculator.Views.Pages.MenuSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:usercontrols="clr-namespace:HashCalculator.Views.UserControls"
    xmlns:userctrlmodels="clr-namespace:HashCalculator.ViewModels.UserControls"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <wpfui:CardControl>
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="安装右键菜单并关联文件" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="安装本程序对系统右键菜单的扩展模块，并建立程序与 .hcb 文件的关联。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Button
                    Command="{Binding InstallShellExtCmd}"
                    Content="安装"
                    IsEnabled="{Binding ProcessingShellExtension, Converter={StaticResource ReverseBooleanValueCvt}}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="卸载右键菜单并取消关联" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="卸载本程序对系统右键菜单的扩展模块，并取消程序与 .hcb 文件的关联。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Button
                    Command="{Binding UnInstallShellExtCmd}"
                    Content="卸载"
                    IsEnabled="{Binding ProcessingShellExtension, Converter={StaticResource ReverseBooleanValueCvt}}" />
            </wpfui:CardControl>
            <wpfui:CardExpander Margin="0,4,0,0">
                <wpfui:CardExpander.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="右键菜单扩展模块状态信息和说明" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="包含 HashCalculator 的右键菜单扩展的安装状态、安装位置、帮助信息等。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardExpander.Header>
                <StackPanel>
                    <wpfui:CardControl Header="安装状态">
                        <wpfui:TextBlock
                            Margin="0,0,4,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding DisplayingShellInstallationState}" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="安装位置">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DisplayingShellExtensionDir}" />
                            <Button
                                Margin="16,0,0,0"
                                Click="ButtonBrowseInstallationLocationClick"
                                Content="打开" />
                        </StackPanel>
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="生效范围">
                        <wpfui:TextBlock
                            Margin="0,0,4,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding DisplayingShellInstallationScope}" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <StackPanel>
                                <wpfui:TextBlock Text="程序路径" />
                                <wpfui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="移动过应用程序位置后，需要更新应用程序路径或者重新安装右键菜单，否则右键菜单将无法调起程序。"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                        </wpfui:CardControl.Header>
                        <Button
                            Margin="16,0,0,0"
                            Click="ButtonUpdateApplicationPathClick"
                            Content="更新" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Margin="0,4,0,0">
                        <wpfui:CardControl.Header>
                            <StackPanel>
                                <wpfui:TextBlock Text="其他须知的原理和提示" />
                                <wpfui:TextBlock
                                    FontTypography="Caption"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="状态为未安装时【安装位置】跟随配置文件的保存位置，已安装则表示实际安装位置；状态为未安装时【生效范围】指如果安装后将会生效的范围，已安装则表示实际生效范围。&#10;以管理员身份启动 HashCalculator 后安装则【生效范围】是当前系统，否则是当前用户。&#10;安装右键菜单后，程序会在【安装位置】下释放外壳扩展模块 HashCalculator[32].dll，不可强制移动、删除、重命名 HashCalculator[32].dll 文件，否则右键菜单将失效。&#10;删除 HashCalculator.exe 前先卸载右键菜单，程序会清理注册表并删除菜单扩展模块，下载新版本后先在旧版本上卸载右键菜单再打开新版本安装右键菜单以避免出现兼容问题。&#10;如果安装位置是用户目录，即使生效范围是【当前系统】，其他用户也可能无法访问菜单。"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                        </wpfui:CardControl.Header>
                    </wpfui:CardControl>
                </StackPanel>
            </wpfui:CardExpander>
            <wpfui:CardExpander Margin="0,4,0,0">
                <wpfui:CardExpander.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="自定义已经安装的菜单条目" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="通过编辑配置文件实现自定义要集成到系统右键菜单的 HashCalculator 菜单项，提高操作效率。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <wpfui:Button
                            Appearance="Primary"
                            Command="{Binding LoadContextMenuConfigCmd}"
                            Content="载入当前菜单" />
                        <wpfui:Button
                            Margin="16,0,0,0"
                            Appearance="Primary"
                            Command="{Binding SaveContextMenuConfigCmd}"
                            Content="保存当前改动" />
                        <wpfui:Button
                            Margin="16,0,0,0"
                            Appearance="Primary"
                            Command="{Binding CancelContextMenuConfigCmd}"
                            Content="取消" />
                        <wpfui:Button
                            Margin="16,0,0,0"
                            Appearance="Danger"
                            Command="{Binding ResetContextMenuConfigCmd}"
                            Content="恢复默认" />
                    </StackPanel>
                    <wpfui:TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        FontTypography="BodyStrong"
                        Text="一级菜单项" />
                    <wpfui:TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="16,8,0,0"
                        FontTypography="BodyStrong"
                        Text="二级菜单项" />
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <usercontrols:ShellMenuEditorControl DataContext="{Binding LoadedShellMenuEditorModel, Mode=OneWay}" />
                    </Border>
                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="16,4,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <usercontrols:ShellSubmenuEditorControl DataContext="{Binding LoadedShellMenuEditorModel.SelectedMenu, Mode=OneWay}" />
                    </Border>
                    <wpfui:TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="表格算法列中的下拉列表允许同时勾选多个算法，可以实现右键菜单一键使用多个算法进行计算。如果不勾选任何算法，则按设置中指定的行为自动选择算法。注意：当前显示哪个算法不重要，只有被勾选的算法起作用。"
                        TextWrapping="WrapWithOverflow" />
                </Grid>
            </wpfui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
