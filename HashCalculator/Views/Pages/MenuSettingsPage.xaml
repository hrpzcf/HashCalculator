<Page
    x:Class="HashCalculator.Views.Pages.MenuSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox
                Padding="4"
                Foreground="#FF006FD6"
                Header="扩展系统右键菜单和关联 .hcb 文件">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpfui:Button
                            MinHeight="36"
                            Padding="32,0"
                            Appearance="Primary"
                            Command="{Binding InstallShellExtCmd}"
                            Content="安装右键菜单并关联文件"
                            IsEnabled="{Binding ProcessingShellExtension, Converter={StaticResource ReverseBooleanValueCvt}}" />
                        <wpfui:Button
                            MinHeight="36"
                            Margin="16,0,0,0"
                            Padding="32,0"
                            Appearance="Danger"
                            Command="{Binding UnInstallShellExtCmd}"
                            Content="卸载右键菜单并取消关联"
                            IsEnabled="{Binding ProcessingShellExtension, Converter={StaticResource ReverseBooleanValueCvt}}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="Black" Text="安装状态：" />
                        <TextBlock Style="{StaticResource DescTextBlockStyle}" Text="{Binding DisplayingShellInstallationState}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="Black" Text="安装位置：" />
                        <TextBlock Style="{StaticResource DescTextBlockStyle}" Text="{Binding DisplayingShellExtensionDir}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="Black" Text="生效范围：" />
                        <TextBlock Style="{StaticResource DescTextBlockStyle}" Text="{Binding DisplayingShellInstallationScope}" />
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="1. 状态为未安装时【安装位置】跟随配置文件的保存位置，已安装则表示实际安装位置" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="2. 状态为未安装时【生效范围】是指如果安装后将会生效的范围，已安装则表示实际生效范围" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="3. 以管理员身份启动 HashCalculator 后安装则【生效范围】是当前系统，否则是当前用户" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="8pt"
                                Style="{StaticResource DescTextBlockStyle}"
                                Text="4. 安装右键菜单后，程序会在 " />
                            <TextBlock
                                Cursor="Hand"
                                Foreground="Blue"
                                MouseLeftButtonDown="OnTextBlockMouseLeftButtonDown"
                                Text="{Binding Source={x:Static pagemodels:SettingsViewModel.ShellExtDir}}" />
                            <TextBlock
                                FontSize="8pt"
                                Style="{StaticResource DescTextBlockStyle}"
                                Text=" 下释放外壳扩展模块 (HashCalculator[32].dll 文件)" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="5. 不可强制移动、删除、重命名 HashCalculator[32].dll 文件，否则右键菜单将失效" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="8pt"
                                Style="{StaticResource DescTextBlockStyle}"
                                Text="6. 移动或重命名 HashCalculator.exe 文件后，需 " />
                            <TextBlock
                                Cursor="Hand"
                                Foreground="Red"
                                MouseLeftButtonDown="OnTextBlockMouseLeftButtonDown"
                                Text="{Binding Source={x:Static pagemodels:SettingsViewModel.UpdateExePath}}" />
                            <TextBlock
                                FontSize="8pt"
                                Style="{StaticResource DescTextBlockStyle}"
                                Text="，否则将无法被右键菜单唤起" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="7. 删除 HashCalculator.exe 前先卸载右键菜单，程序会清理注册表并删除菜单扩展模块" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Foreground="Red"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="8. 下载新版本后先在旧版本上卸载右键菜单再打开新版本安装右键菜单以避免出现兼容问题" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Foreground="Red"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="9. 如果安装位置是用户目录，即使生效范围是【当前系统】，其他用户也可能无法访问菜单" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="10. 关联 .hcb 文件后，使用 HashCalculator 导出的 .hcb 文件可通过双击进行快速校验" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="8pt"
                            Style="{StaticResource DescTextBlockStyle}"
                            Text="11. 通过双击打开 .hcb 文件进行快速校验要求待计算哈希值的文件与 .hcb 文件在同一目录下" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox
                Margin="0,8,0,0"
                Padding="4"
                Foreground="#FF006FD6"
                Header="自定义要集成到系统右键菜单的菜单项">
                <StackPanel>
                    <wpfui:Button
                        MinHeight="36"
                        Padding="20,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding OpenEditContextMenuCmd}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource DescTextBlockStyle}"
                        Text="通过编辑配置实现自定义要集成到系统右键菜单上的 HashCalculator 菜单项，提高操作效率" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Page>
