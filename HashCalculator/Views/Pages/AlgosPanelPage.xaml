<Page
    x:Class="HashCalculator.Views.Pages.AlgosPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="默认算法"
    d:DataContext="{d:DesignInstance Type=pagemodels:AlgosPanelPageModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ListBox
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.IsSharedSizeScope="True"
                    ItemsSource="{x:Static pagemodels:AlgosPanelPageModel.AlgoGroups}"
                    SelectedItem="{Binding SelectedAlgoGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="algGroupCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,24,0"
                                    Text="{Binding GroupName}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedAlgoCount, StringFormat=已选：{0}}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ListBoxIsSelectedForegroundCvt}">
                                            <Binding Path="IsSelected" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}" />
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedAlgoGroup.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="16,4"
                                    VerticalContentAlignment="Center"
                                    CommandParameter="{Binding}"
                                    Content="{Binding AlgoName}"
                                    IsChecked="{Binding Selected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,4,0,0"
                    FontSize="8pt"
                    Style="{StaticResource DescTextBlockStyle}"
                    Text="不建议选择太多算法，否则计算时极易造成程序无响应" />
            </Grid>
            <wpfui:Button
                Grid.Row="1"
                Margin="0,8,0,4"
                Padding="20,4,20,4"
                HorizontalAlignment="Right"
                Appearance="Caution"
                Command="{Binding ClearAllSelectedCmd}"
                Content="清除" />
        </Grid>
    </ScrollViewer>
</Page>
