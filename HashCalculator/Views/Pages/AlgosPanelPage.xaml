<Page
    x:Class="HashCalculator.Views.Pages.AlgosPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HashCalculator.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:AlgorithmsModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Padding="8"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <wpfui:ListView
                Grid.IsSharedSizeScope="True"
                ItemsSource="{x:Static pagemodels:AlgorithmsModel.AlgoGroups}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedAlgoGroup}">
                <wpfui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="algGroupCol" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                Text="{Binding GroupName}" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding SelectedAlgoCount, StringFormat=已选：{0}}" />
                        </Grid>
                    </DataTemplate>
                </wpfui:ListView.ItemTemplate>
            </wpfui:ListView>
        </Border>
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="1"
            Margin="8,0,0,0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SelectedAlgoGroup.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <wpfui:CardControl
                            Margin="16,0,0,8"
                            Padding="12"
                            Header="{Binding AlgoName}">
                            <wpfui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Selected, Mode=TwoWay}" />
                        </wpfui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <wpfui:Button
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            Appearance="Primary"
            Command="{Binding ClearAllSelectedCmd}"
            Content="清除所有选择" />
        <wpfui:TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="20,0,0,0"
            VerticalAlignment="Bottom"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="不建议选择太多算法，否则计算时容易造成程序无响应。" />
    </Grid>
</Page>
