<Page
    x:Class="HashCalculator.Views.Pages.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <wpfui:CardExpander
                Grid.Row="0"
                Margin="0,4,0,0"
                ContentPadding="0"
                Icon="{wpfui:ImageIcon '/Images/icon.ico',
                                       Width=32,
                                       Height=32}">
                <wpfui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <wpfui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Bottom"
                            Text="{Binding Title}" />
                        <wpfui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Author, StringFormat='Copyright © {0} 和 HashCalculator 的贡献者们。'}"
                            TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,64,0"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Ver, StringFormat='当前版本：{0}'}" />
                    </Grid>
                </wpfui:CardExpander.Header>
                <StackPanel>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding Website}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Text="推荐站点" />
                            <wpfui:TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Website}"
                                TextWrapping="WrapWithOverflow" />
                            <wpfui:SymbolIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding SrcGitHub}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Text="项目地址" />
                            <wpfui:TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SrcGitHub}"
                                TextWrapping="WrapWithOverflow" />
                            <wpfui:SymbolIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding IssueGitHub}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Text="问题反馈" />
                            <wpfui:TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding IssueGitHub}"
                                TextWrapping="WrapWithOverflow" />
                            <wpfui:SymbolIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding WikiGitHub}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Text="使用帮助" />
                            <wpfui:TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding WikiGitHub}"
                                TextWrapping="WrapWithOverflow" />
                            <wpfui:SymbolIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        NavigateUri="{Binding ChangeLogGitHub}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontTypography="Caption"
                                Text="更新日志" />
                            <wpfui:SymbolIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                </StackPanel>
            </wpfui:CardExpander>
            <wpfui:CardExpander
                Grid.Row="1"
                Margin="0,4,0,0"
                ContentPadding="0,0,0,-1"
                Icon="{wpfui:SymbolIcon Symbol=Code24,
                                        FontSize=32}">
                <wpfui:CardExpander.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="使用的开源项目" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Ver, StringFormat='HashCalculator 当前版本 ( {0} ) 所使用的开源项目清单。'}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardExpander.Header>
                <ItemsControl
                    Grid.Row="3"
                    d:ItemsSource="{d:SampleData ItemCount=10}"
                    Grid.IsSharedSizeScope="True"
                    ItemsSource="{Binding OpenSourceProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <wpfui:Anchor
                                    Padding="16"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    d:DataContext="{d:DesignInstance Type=local:GenericItemModel}"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    NavigateUri="{Binding Param}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <wpfui:TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontTypography="Caption"
                                            Text="{Binding Display}"
                                            TextWrapping="WrapWithOverflow" />
                                        <wpfui:TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ItemValue}"
                                            TextWrapping="WrapWithOverflow" />
                                        <wpfui:SymbolIcon
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Symbol="Link24" />
                                    </Grid>
                                </wpfui:Anchor>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </wpfui:CardExpander>
            <StackPanel
                Grid.Row="2"
                Margin="0,64,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <wpfui:TextBlock
                    Margin="0,0,64,0"
                    FontStyle="Italic"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="三千铁衣披霜  万籁绝响  举目是残阳" />
                <wpfui:TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    FontStyle="Italic"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="——《栖凰》" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
