<Page
    x:Class="HashCalculator.Views.Pages.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <wpfui:TextBlock
                Margin="4,0,0,0"
                FontTypography="BodyStrong"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="关于软件"
                TextWrapping="WrapWithOverflow" />
            <wpfui:CardExpander
                Margin="0,4,0,0"
                ContentPadding="0"
                Icon="{wpfui:ImageIcon '/Images/icon.ico',
                                       Width=32,
                                       Height=32}">
                <wpfui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <wpfui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="16"
                            Text="{Binding Title}" />
                        <wpfui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Author, StringFormat='Copyright © {0} 和 HashCalculator 的贡献者们。'}"
                            TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,32,0"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Ver, StringFormat='版本：{0}'}" />
                    </Grid>
                </wpfui:CardExpander.Header>
                <StackPanel>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding Website}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock Grid.Column="0" Text="项目主页" />
                            <wpfui:SymbolIcon Grid.Column="1" Symbol="Home24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding SrcGitHub}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock Grid.Column="0" Text="项目地址" />
                            <wpfui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding IssueGitHub}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock Grid.Column="0" Text="问题反馈" />
                            <wpfui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0"
                        NavigateUri="{Binding WikiGitHub}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock Grid.Column="0" Text="使用帮助" />
                            <wpfui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                    <wpfui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        NavigateUri="{Binding ChangeLogGitHub}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:TextBlock Grid.Column="0" Text="更新日志" />
                            <wpfui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </wpfui:Anchor>
                </StackPanel>
            </wpfui:CardExpander>
            <wpfui:TextBlock
                Margin="4,16,0,0"
                FontTypography="BodyStrong"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="使用的开源项目"
                TextWrapping="WrapWithOverflow" />
            <ItemsControl
                Grid.Row="3"
                Margin="0,4,0,0"
                d:ItemsSource="{d:SampleData ItemCount=10}"
                Grid.IsSharedSizeScope="True"
                ItemsSource="{Binding OpenSourceProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <wpfui:Anchor
                                Margin="0,2,0,0"
                                Padding="16,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                d:DataContext="{d:DesignInstance Type=local:GenericItemModel}"
                                NavigateUri="{Binding Param}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <wpfui:TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontTypography="Body"
                                        Text="{Binding Display}"
                                        TextWrapping="WrapWithOverflow" />
                                    <wpfui:TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,4,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ItemValue}"
                                        TextWrapping="WrapWithOverflow" />
                                    <wpfui:SymbolIcon
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Symbol="Link24" />
                                </Grid>
                            </wpfui:Anchor>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
