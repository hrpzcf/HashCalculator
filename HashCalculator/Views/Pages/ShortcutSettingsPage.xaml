<Page
    x:Class="HashCalculator.Views.Pages.ShortcutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <wpfui:TextBlock
                Margin="4,0,0,0"
                FontTypography="BodyStrong"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="部分列的鼠标左键双击行为" />
            <wpfui:CardControl Margin="0,4,0,0" Header="序号列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding SerialColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="文件名列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FileNameColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="完整路径列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FullPathColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="文件大小列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FileSizeColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="哈希值列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding HashValueColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="任务耗时列">
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding DurationColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
