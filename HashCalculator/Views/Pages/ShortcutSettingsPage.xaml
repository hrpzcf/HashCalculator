<Page
    x:Class="HashCalculator.Views.Pages.ShortcutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
        <GroupBox
            Padding="4"
            Foreground="#FF006FD6"
            Header="部分列的鼠标左键双击行为">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="序号列：" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="150"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding SerialColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="文件名列：" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FileNameColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="完整路径列：" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FullPathColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="文件大小列：" />
                <ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding FileSizeColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="哈希值列：" />
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding HashValueColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Text="任务耗时列：" />
                <ComboBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableColLeftDoubleClickCmds}"
                    SelectedValue="{Binding DurationColumnLeftDoubleClick}"
                    SelectedValuePath="ItemValue" />
            </Grid>
        </GroupBox>
    </ScrollViewer>
</Page>
