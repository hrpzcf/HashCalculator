                        VerticalAlignment="Center"
                        Text="快捷操作设置" />
                </StackPanel>
            </TabItem.Header>

        </TabItem>
        <TabItem FontSize="10pt">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="19pt"
                        Text="&#xe6b7;" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="配置文件保存位置" />
                </StackPanel>
            </TabItem.Header>

        </TabItem>
        <TabItem FontSize="10pt">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="19pt"
                        Text="&#xe646;" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="关于软件" />
                </StackPanel>
            </TabItem.Header>

        </TabItem>
    </TabControl>
</Page>
