<Page
    x:Class="HashCalculator.Views.Pages.TaskSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HashCalculator.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <controls:MinLimitedCardControl>
                <controls:MinLimitedCardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="同时进行的任务数上限" />
                        <wpfui:TextBlock
                            Margin="0,2,0,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="上限选项中除了 1，其他选项都与下一个设置互斥，无法同时开启。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </controls:MinLimitedCardControl.Header>
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableTaskNumLimits}"
                    SelectedValue="{Binding SelectedTaskNumberLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="ItemValue" />
            </controls:MinLimitedCardControl>
            <controls:MinLimitedCardControl Margin="0,4,0,0" Header="任务包含多个算法时多个算法并行计算">
                <wpfui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ParallelBetweenAlgos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:MinLimitedCardControl>
            <controls:MinLimitedCardControl Margin="0,4,0,0" Header="文件被添加后自动启动对该文件的计算任务">
                <wpfui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutomaticallyStartAfterModelAdded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:MinLimitedCardControl>
            <controls:MinLimitedCardControl Margin="0,4,0,0">
                <controls:MinLimitedCardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="按此数量分批将文件添加到主页" />
                        <wpfui:TextBlock
                            Margin="0,2,0,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="设为 0 是逐条将搜索到的文件添加到主页上，否则分批添加（不会妨碍数量少于此值的情况）。当大批小文件计算完成速度快于文件添加速度时，调整合适的批量值可以更快完成全部计算。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </controls:MinLimitedCardControl.Header>
                <Slider
                    MinWidth="200"
                    AutoToolTipPlacement="BottomRight"
                    AutoToolTipPrecision="0"
                    IsSnapToTickEnabled="True"
                    Maximum="30"
                    Minimum="0"
                    TickFrequency="5"
                    TickPlacement="TopLeft"
                    Value="{Binding AddHashViewModelsBatchSize, Mode=TwoWay}" />
            </controls:MinLimitedCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
