<Page
    x:Class="HashCalculator.Views.Pages.TaskSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <wpfui:CardControl>
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="同时进行的任务数上限" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="上限选项中除了 1，其他选项都与下一个设置互斥，无法同时开启。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <ComboBox
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding AvailableTaskNumLimits}"
                    SelectedValue="{Binding SelectedTaskNumberLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="ItemValue" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="任务包含多个算法时多个算法并行计算">
                <wpfui:ToggleSwitch IsChecked="{Binding ParallelBetweenAlgos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="延迟启动被添加到表格中的哈希值计算任务">
                <wpfui:ToggleSwitch IsChecked="{Binding DelayTheStartOfCalculationTasks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" IsEnabled="{Binding DelayTheStartOfCalculationTasks, Mode=OneWay}">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="延迟启动的毫秒数" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="此项设置可一定程度缓解“添加任务”和“启动任务”同时进行导致的表格显示卡顿。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <TextBox
                    MinWidth="100"
                    MaxLines="1"
                    Text="{Binding MillisecondsOfDelayedStartup, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="文件被添加后自动启动对该文件的计算任务">
                <wpfui:ToggleSwitch IsChecked="{Binding AutomaticallyStartTaskAfterFileAdded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="按此数量分批将文件添加到主页" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="设为 0 则逐条将搜索到的文件添加到主页上，否则成批添加（不会妨碍数量少于此值的情况）。当计算大批小文件完成速度快于文件显示速度时，调整合适的批量值可以更快完成全部计算。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Slider
                    MinWidth="200"
                    AutoToolTipPlacement="BottomRight"
                    AutoToolTipPrecision="0"
                    IsSnapToTickEnabled="True"
                    Maximum="30"
                    Minimum="0"
                    TickFrequency="5"
                    TickPlacement="TopLeft"
                    Value="{Binding AddHashViewModelsBatchSize, Mode=TwoWay}" />
            </wpfui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
