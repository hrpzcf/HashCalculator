<Page
    x:Class="HashCalculator.Views.Pages.InterfaceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <wpfui:CardControl>
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="应用主题" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="设置应用程序的主题颜色。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <ComboBox SelectedIndex="{Binding SelectedApplicationThemeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="深色" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="高对比度" />
                </ComboBox>
            </wpfui:CardControl>
            <wpfui:CardExpander Margin="0,4,0,0">
                <wpfui:CardExpander.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="部分列的显示与隐藏" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="部分列的显示与隐藏开关。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardExpander.Header>
                <StackPanel>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="序号列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoSerialNumColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="完整路径列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoFullPathColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="文件大小列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoFileSizeColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="输出方式列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoOutputTypeColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="任务耗时列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoDurationColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="导出列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoExportColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                    <wpfui:CardControl>
                        <wpfui:CardControl.Header>
                            <wpfui:TextBlock Text="校验结果列" TextWrapping="WrapWithOverflow" />
                        </wpfui:CardControl.Header>
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding NoCmpResultColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="显示"
                            OnContent="隐藏" />
                    </wpfui:CardControl>
                </StackPanel>
            </wpfui:CardExpander>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <wpfui:TextBlock Text="在校验结果图标旁显示描述" TextWrapping="WrapWithOverflow" />
                </wpfui:CardControl.Header>
                <wpfui:ToggleSwitch IsChecked="{Binding ShowResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <wpfui:TextBlock Text="显示表格中文件的图标" TextWrapping="WrapWithOverflow" />
                </wpfui:CardControl.Header>
                <wpfui:ToggleSwitch IsChecked="{Binding ShowFileIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <wpfui:TextBlock Text="显示主窗口功能按钮的名称" TextWrapping="WrapWithOverflow" />
                </wpfui:CardControl.Header>
                <wpfui:ToggleSwitch IsChecked="{Binding DisplayMainWndButtonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="功能按钮显隐总开关" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="取消勾选并关闭设置窗口后可通过点击右键菜单“显示功能按钮”重新显示。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <wpfui:ToggleSwitch IsChecked="{Binding DisplayMainWindowButtons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardExpander Margin="0,4,0,0">
                <wpfui:CardExpander.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="功能按钮显隐细分开关" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="分别设置要显示的功能按钮，需要启用“显示主窗口所有功能按钮”，否则所有功能按钮都不显示。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardExpander.Header>
                <StackPanel>
                    <wpfui:CardControl Header="默认输出方式按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowSelectedOutputTypeButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="刷新筛选按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowApplyRefreshFilterslButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="选择文件按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowSelectFilesToHashButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="选择目录按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowSelectFoldersToHashButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="停止搜索按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowStopEnumeratingPackageButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="导出结果按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowExportHashResultsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="新行重算按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowCopyAndRestartModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="计算缺值项按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowRefreshOriginalModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="重新计算按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowForceRefreshOriginalModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="清空表格按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowClearAllTableLinesButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="全部开始按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowContinueDisplayedModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="全部暂停按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowPauseDisplayedModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="全部取消按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowCancelDisplayedModelsButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                    <wpfui:CardControl Header="置顶窗口按钮">
                        <wpfui:ToggleSwitch
                            IsChecked="{Binding ShowMainWindowTopmostButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            LabelPosition="Left"
                            OffContent="隐藏"
                            OnContent="显示" />
                    </wpfui:CardControl>
                </StackPanel>
            </wpfui:CardExpander>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="相同哈希值行的强调色参数" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="开启“使用颜色来标记哈希值相同的行”后，可以通过调整此参数避免上色时与字体色或背景色过于接近导致不易分辨。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Grid MinWidth="320">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="WeatherSunny32"
                        ToolTip="颜色亮度" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="230"
                        Minimum="30"
                        TickFrequency="1"
                        Value="{Binding LuminanceOfTableRowsWithSameHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <wpfui:SymbolIcon
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="CircleHalfFill20"
                        ToolTip="色饱和度" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,8,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="240"
                        Minimum="10"
                        TickFrequency="1"
                        Value="{Binding SaturationOfTableRowsWithSameHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="筛选相同哈希值行的强调色参数" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="筛选相同哈希值时，相同哈希值的行会被上色，可以通过调整此参数避免上色时与字体色或背景色过于接近导致不易分辨。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Grid MinWidth="320">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="WeatherSunny32"
                        ToolTip="颜色亮度" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="230"
                        Minimum="30"
                        TickFrequency="1"
                        Value="{Binding LuminanceOfTableCellsWithSameHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <wpfui:SymbolIcon
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="CircleHalfFill20"
                        ToolTip="色饱和度" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,8,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="240"
                        Minimum="10"
                        TickFrequency="1"
                        Value="{Binding SaturationOfTableCellsWithSameHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="筛选相同文件夹时的强调色参数" TextWrapping="WrapWithOverflow" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="筛选相同文件夹时，相同文件夹的行会被上色，可以通过调整此参数避免上色时与字体色或背景色过于接近导致不易分辨。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Grid MinWidth="320">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <wpfui:SymbolIcon
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="WeatherSunny32"
                        ToolTip="颜色亮度" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="230"
                        Minimum="30"
                        TickFrequency="1"
                        Value="{Binding LuminanceOfTableCellsWithSameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <wpfui:SymbolIcon
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Symbol="CircleHalfFill20"
                        ToolTip="色饱和度" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,8,0,0"
                        AutoToolTipPlacement="BottomRight"
                        AutoToolTipPrecision="0"
                        IsSnapToTickEnabled="True"
                        Maximum="240"
                        Minimum="10"
                        TickFrequency="1"
                        Value="{Binding SaturationOfTableCellsWithSameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0">
                <wpfui:CardControl.Header>
                    <StackPanel>
                        <wpfui:TextBlock Text="Snackbar 提示条显示时长" />
                        <wpfui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Snackbar 提示条就是窗口底部弹出的信息提示条，时长单位是秒。"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </wpfui:CardControl.Header>
                <Slider
                    MinWidth="310"
                    AutoToolTipPlacement="BottomRight"
                    AutoToolTipPrecision="0"
                    IsSnapToTickEnabled="True"
                    Maximum="10"
                    Minimum="1"
                    TickFrequency="1"
                    TickPlacement="TopLeft"
                    Value="{Binding SnackbarNotificationTimeSpanSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="重置所有颜色亮度和饱和度值">
                <Button Command="{Binding ResetLuminanceAndSaturationValuesCmd}" Content="重置" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="重置主窗口表格所有列的顺序">
                <Button Click="ResetHomePageDataGridColumnsIndex" Content="重置" />
            </wpfui:CardControl>
            <wpfui:CardControl Margin="0,4,0,0" Header="重置主窗口表格所有列的宽度">
                <Button Click="ResetHomePageDataGridColumnsWidth" Content="重置" />
            </wpfui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
