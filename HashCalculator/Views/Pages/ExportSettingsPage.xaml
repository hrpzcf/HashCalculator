<Page
    x:Class="HashCalculator.Views.Pages.ExportSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:usercontrols="clr-namespace:HashCalculator.Views.UserControls"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=pagemodels:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding SettingsPagesInputBindingsCmd}" />
    </Page.InputBindings>
    <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <usercontrols:ExportSettingsBasicControl />
            <usercontrols:ExportSettingsTemplateControl />
        </StackPanel>
    </ScrollViewer>
</Page>
