<wpfui:FluentWindow
    x:Class="HashCalculator.Views.Windows.FilterOperationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:winmodels="clr-namespace:HashCalculator.ViewModels.Windows"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="筛选与操作"
    Width="{Binding Source={x:Static local:Settings.Current}, Path=FilterOperationWindowWidth, Mode=TwoWay}"
    Height="{Binding Source={x:Static local:Settings.Current}, Path=FilterOperationWindowHeight, Mode=TwoWay}"
    d:DataContext="{d:DesignInstance Type=pagemodels:FilterOperationModel}"
    Closed="FilterOperationWindowClosed"
    Left="{Binding Source={x:Static local:Settings.Current}, Path=FilterOperationWindowLeft, Mode=TwoWay}"
    Loaded="FilterOperationWindowLoaded"
    ScrollViewer.CanContentScroll="False"
    SnapsToDevicePixels="True"
    Top="{Binding Source={x:Static local:Settings.Current}, Path=FilterOperationWindowTop, Mode=TwoWay}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <wpfui:TitleBar
            Title="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=wpfui:FluentWindow}, Path=Title}"
            Grid.Row="0"
            Height="30"
            ShowMaximize="False">
            <wpfui:TitleBar.Icon>
                <wpfui:ImageIcon Source="/Images/icon.ico" />
            </wpfui:TitleBar.Icon>
        </wpfui:TitleBar>
        <wpfui:NavigationView
            x:Name="NavigationViewOnFilterWindow"
            Grid.Row="1"
            Margin="0,4,4,8"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="False"
            IsPaneOpen="False"
            IsTopSeparatorVisible="False"
            MenuItemsSource="{Binding MenuItems, Mode=OneWay}"
            OpenPaneLength="90"
            PaneDisplayMode="Left"
            TransitionDuration="100" />
    </Grid>
</wpfui:FluentWindow>
