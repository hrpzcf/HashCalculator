<local:CustomFluentWindow
    x:Class="HashCalculator.Views.Windows.HashDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="详情"
    Width="{Binding Source={x:Static local:Settings.Current}, Path=HashDetailsWndWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Height="{Binding Source={x:Static local:Settings.Current}, Path=HashDetailsWndHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    d:DataContext="{d:DesignInstance Type=local:HashViewModel}"
    d:Width="500"
    KeyDown="HashDetailsWndKeyDown"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <wpfui:TitleBar
            Title="详情"
            Grid.Row="0"
            Height="30">
            <wpfui:TitleBar.Icon>
                <wpfui:ImageIcon Source="/Images/icon.ico" />
            </wpfui:TitleBar.Icon>
        </wpfui:TitleBar>
        <Grid Grid.Row="1" Margin="8,4,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <wpfui:CardExpander Grid.Row="0" Header="文件和算法信息">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="文件路径：" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="5"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        IsReadOnly="True"
                        Text="{Binding Information.FullName, Mode=OneWay}"
                        TextWrapping="WrapWithOverflow" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="算法数量：" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        IsReadOnly="True"
                        Text="{Binding AlgoInOutModels.Count, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Text="文件大小：" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="3"
                        IsReadOnly="True">
                        <TextBox.Text>
                            <MultiBinding Mode="OneWay" StringFormat="{}{1} ({0} 字节)">
                                <Binding Path="FileLength" />
                                <Binding Converter="{StaticResource BytesToIntuitiveFileSizeCvt}" Path="FileLength" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Text="任务耗时：" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="5"
                        IsReadOnly="True"
                        Text="{Binding DurationofTask, StringFormat={}{0:F2} 秒, Mode=OneWay}" />
                </Grid>
            </wpfui:CardExpander>
            <DataGrid
                Grid.Row="2"
                Margin="0,8,0,0"
                AutoGenerateColumns="False"
                Grid.IsSharedSizeScope="True"
                IsReadOnly="True"
                ItemsSource="{Binding AlgoInOutModels}"
                LostFocus="OnHashResultDataGridLostFocus"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="算法">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding AlgoName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="哈希值">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource BytesToStrByOutputTypeCvt}">
                                                <Binding Mode="OneWay" Path="HashResult" />
                                                <Binding
                                                    Mode="OneWay"
                                                    Path="DataContext.SelectedOutputType"
                                                    RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                    AncestorType={x:Type Window}}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button
                                        Grid.Column="1"
                                        Padding="4"
                                        Command="{Binding CopyHashResultCmd}"
                                        CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                        Content="&#xe718;"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="14pt"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                        Style="{StaticResource ImageButtonStyle1}"
                                        ToolTip="按模板复制..." />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="导出">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsChecked="{Binding Export, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="校验结果">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HashCmpResult, Converter={StaticResource ComparisonResultToVisibilityCvt}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Padding="3"
                                        Background="Transparent"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="22px"
                                        Foreground="{Binding HashCmpResult, Converter={StaticResource ComparisonResultToForegroundCvt}}"
                                        Text="{Binding HashCmpResult, Converter={StaticResource ComparisonResultToIconFontTextCvt}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding HashCmpResult, Converter={StaticResource ComparisonResultToTextCvt}}"
                                        Visibility="{Binding Source={x:Static local:Settings.Current}, Path=ShowResultText, Converter={StaticResource FalseToVisibilityCollapsedCvt}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <wpfui:ContentDialogHost x:Name="RootContentDialogHost" />
    </Grid>
</local:CustomFluentWindow>
