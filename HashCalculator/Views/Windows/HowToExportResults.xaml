<wpfui:FluentWindow
    x:Class="HashCalculator.Views.Windows.HowToExportResults"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:userctrls="clr-namespace:HashCalculator.Views.UserControls"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="610"
    Height="Auto"
    d:DataContext="{d:DesignInstance pagemodels:SettingsViewModel}"
    KeyDown="WindowKeyDown"
    ScrollViewer.CanContentScroll="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <wpfui:TitleBar
            Title="调整导出行为"
            Grid.Row="0"
            Height="30"
            ShowMaximize="False"
            ShowMinimize="False">
            <wpfui:TitleBar.Icon>
                <wpfui:ImageIcon Source="/Images/icon.ico" />
            </wpfui:TitleBar.Icon>
        </wpfui:TitleBar>
        <Grid Grid.Row="1" Margin="14,4,14,14">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <userctrls:ExportSettingsBasicControl
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2" />
            <wpfui:TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="4,8,0,0"
                VerticalAlignment="Bottom"
                FontTypography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="按 ESC 键取消导出操作并关闭此窗口。" />
            <wpfui:Button
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="ButtonConfirmClick"
                Content="确定"
                IsDefault="True" />
        </Grid>
        <wpfui:ContentDialogHost x:Name="RootContentDialogHost" />
    </Grid>
</wpfui:FluentWindow>
