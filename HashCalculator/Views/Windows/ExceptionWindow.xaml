<wpfui:FluentWindow
    x:Class="HashCalculator.Views.Windows.ExceptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winmodels="clr-namespace:HashCalculator.ViewModels.Windows"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="{Binding ExceptionWindowWidth, Source={x:Static local:Settings.Current}, Mode=TwoWay}"
    Height="{Binding ExceptionWindowHeight, Source={x:Static local:Settings.Current}, Mode=TwoWay}"
    d:DataContext="{d:DesignInstance Type=winmodels:ExceptionWindowModel}"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <wpfui:TitleBar
            Title="异常中断"
            Grid.Row="0"
            Height="30">
            <wpfui:TitleBar.Icon>
                <wpfui:ImageIcon Source="/Images/icon.ico" />
            </wpfui:TitleBar.Icon>
        </wpfui:TitleBar>
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <wpfui:TextBox
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                VerticalContentAlignment="Top"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding StackTraceMessage, Mode=OneWay}"
                VerticalScrollBarVisibility="Auto" />
            <wpfui:TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                FontTypography="Caption"
                Text="问题反馈：点击右侧按钮复制异常内容，在打开的浏览器页面登录后新建 Issues 并粘贴发布。" />
            <wpfui:TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                FontTypography="Caption"
                Text="如果复制失败请手动全选以上信息并复制，打开“设置👉关于软件👉哈希值计算器👉问题反馈”打开反馈页面。" />
            <wpfui:SplitButton
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="0,8,0,0"
                VerticalAlignment="Center"
                Command="{Binding FeedbackCommand}"
                CommandParameter="GitHub"
                Content="复制并反馈">
                <wpfui:SplitButton.Flyout>
                    <ContextMenu>
                        <wpfui:MenuItem
                            Command="{Binding FeedbackCommand}"
                            CommandParameter="Gitee"
                            Header="复制并反馈(Gitee)" />
                    </ContextMenu>
                </wpfui:SplitButton.Flyout>
            </wpfui:SplitButton>
        </Grid>
        <wpfui:ContentDialogHost x:Name="RootContentDialogHost" />
    </Grid>
</wpfui:FluentWindow>
