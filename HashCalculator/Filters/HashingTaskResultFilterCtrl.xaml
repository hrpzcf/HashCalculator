<UserControl
    x:Class="HashCalculator.HashingTaskResultFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=local:HashingTaskResultFilter}"
    d:DesignWidth="600"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <StackPanel>
        <wpfui:CardControl Padding="8">
            <wpfui:CardControl.Header>
                <StackPanel>
                    <wpfui:TextBlock FontTypography="BodyStrong" Text="要筛选出来的任务状态" />
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="要筛选的任务状态可多选，所有符合被选中的任务状态的行都会被筛选出来。"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:CardControl.Header>
            <ComboBox ItemsSource="{Binding Items}" SelectedIndex="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Padding="0,-1"
                            Content="{Binding Display}"
                            IsChecked="{Binding Selected}"
                            Style="{StaticResource NoMinCheckBoxStyle}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </wpfui:CardControl>
    </StackPanel>
</UserControl>
