<UserControl
    x:Class="HashCalculator.HashAlgoFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=local:HashAlgoFilter}"
    d:DesignWidth="600"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <StackPanel>
        <wpfui:CardControl Padding="8">
            <wpfui:CardControl.Header>
                <StackPanel>
                    <wpfui:TextBlock FontTypography="BodyStrong" Text="要筛选出来的算法" />
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="要筛选的算法可多选，所有符合被选中的算法的行都会被筛选出来。"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:CardControl.Header>
            <ComboBox
                MinWidth="150"
                ItemsSource="{Binding Items}"
                SelectedIndex="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Padding="0,-1"
                            Content="{Binding AlgoName}"
                            IsChecked="{Binding Selected}"
                            Style="{StaticResource NoMinCheckBoxStyle}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </wpfui:CardControl>
        <wpfui:CardControl Margin="0,4,0,0" Padding="8">
            <wpfui:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <wpfui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="对于多个条件的筛选逻辑" />
                    <Button
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ButtonClick">
                        <wpfui:SymbolIcon Symbol="QuestionCircle12" />
                    </Button>
                    <wpfui:Flyout
                        Grid.Column="0"
                        IsOpen="{Binding IsCaptionFlyoutShowed, Mode=TwoWay}"
                        Placement="Top">
                        <TextBlock Text="筛选逻辑列表中的 [要求] 指的是以上下拉列表中已勾选的算法集合，其中：&#10;[满足任意要求] 该行的所有算法中至少有一个算法满足了其中一个要求&#10;[严格满足要求] 该行的所有算法涵盖了要求中的所有算法，且不含要求以外的算法。&#10;[在要求范围内] 该行的所有算法都在要求的多个算法所组成的范围之内。&#10;[涵盖所有要求] 该行的所有算法涵盖了要求中的所有算法，可能含有要求以外的算法。" TextWrapping="WrapWithOverflow" />
                    </wpfui:Flyout>
                </Grid>
            </wpfui:CardControl.Header>
            <ComboBox
                MinWidth="150"
                DisplayMemberPath="Display"
                ItemsSource="{Binding FilterLogics}"
                SelectedValue="{Binding Param}"
                SelectedValuePath="ItemValue" />
        </wpfui:CardControl>
    </StackPanel>
</UserControl>
