<UserControl
    x:Class="HashCalculator.FileNameFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=local:FileNameFilter}"
    d:DesignWidth="600"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <StackPanel>
        <wpfui:CardControl Padding="8">
            <wpfui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <wpfui:TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        MaxLines="1"
                        PlaceholderText="输入文件名片段或正则表达式 (C#)"
                        Text="{Binding Pattern, Mode=OneWayToSource}"
                        TextWrapping="WrapWithOverflow" />
                    <wpfui:ToggleSwitch
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        Padding="0"
                        Content="使用正则表达式"
                        IsChecked="{Binding Param}" />
                    <wpfui:ToggleSwitch
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="16,8,0,0"
                        Padding="0"
                        Content="忽略大小写"
                        IsChecked="{Binding IgnoreCase}" />
                </Grid>
            </wpfui:CardControl.Header>
        </wpfui:CardControl>
    </StackPanel>
</UserControl>
