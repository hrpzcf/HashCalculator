<UserControl
    x:Class="HashCalculator.EqualHashByteFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=local:EqualHashByteFilter}"
    d:DesignWidth="600"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <StackPanel>
        <wpfui:CardExpander Padding="8" ContentPadding="8">
            <wpfui:CardExpander.Header>
                <RadioButton IsChecked="{Binding CheckEmbeddedHashValue, Converter={StaticResource ReverseBooleanValueCvt}}">
                    <RadioButton.Content>
                        <wpfui:TextBlock FontTypography="BodyStrong" Text="在主页显示的所有文件的指定算法的哈希值中查找相同项" />
                    </RadioButton.Content>
                </RadioButton>
            </wpfui:CardExpander.Header>
            <Grid Margin="24,0,0,0" IsEnabled="{Binding CheckEmbeddedHashValue, Converter={StaticResource ReverseBooleanValueCvt}}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="指定第一行当前显示的算法"
                    IsChecked="{Binding AutomaticallyFocusAlgorithm}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="0"
                    MinWidth="0"
                    Content="指定此算法："
                    IsChecked="{Binding AutomaticallyFocusAlgorithm, Converter={StaticResource ReverseBooleanValueCvt}}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="120"
                    DisplayMemberPath="AlgoName"
                    IsEnabled="{Binding AutomaticallyFocusAlgorithm, Converter={StaticResource ReverseBooleanValueCvt}}"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding Param}" />
            </Grid>
        </wpfui:CardExpander>
        <wpfui:CardControl Margin="0,4,0,0" Padding="8">
            <wpfui:CardControl.Header>
                <StackPanel>
                    <RadioButton IsChecked="{Binding CheckEmbeddedHashValue}">
                        <RadioButton.Content>
                            <wpfui:TextBlock FontTypography="BodyStrong" Text="在主页显示的所有文件的内嵌哈希标记中查找相同项(忽略算法)" />
                        </RadioButton.Content>
                    </RadioButton>
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="只有通过本软件添加标记改变哈希值的文件有内嵌的哈希值，内嵌的哈希值是文件被添加标记之前的哈希值，即原文件哈希值。"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:CardControl.Header>
        </wpfui:CardControl>
        <wpfui:CardControl Margin="0,4,0,0" Padding="8">
            <wpfui:CardControl.Header>
                <StackPanel>
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="程序将按指定的算法的哈希值是否相同对当前显示的行进行分组。"
                        TextWrapping="WrapWithOverflow" />
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="此筛选器以其前面已启用筛选器的结果为基础进行分组，对筛选顺序敏感，多数情况下建议作为最后一个筛选器，否则可能得不到预期结果。"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:CardControl.Header>
        </wpfui:CardControl>
    </StackPanel>
</UserControl>
