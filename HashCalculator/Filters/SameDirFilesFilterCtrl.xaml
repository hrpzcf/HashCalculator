<UserControl
    x:Class="HashCalculator.SameDirFilesFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HashCalculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:HashCalculator.ViewModels.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=local:SameDirFilesFilter}"
    d:DesignWidth="600"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">
    <StackPanel>
        <wpfui:CardControl Padding="8">
            <wpfui:CardControl.Header>
                <StackPanel>
                    <wpfui:TextBlock FontTypography="BodyStrong" Text="按文件所在的文件夹对当前显示的所有行进行分组" />
                    <wpfui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="一个文件夹的子文件夹视为与该文件夹是不同的文件夹。&#10;此筛选器以其前面已启用筛选器的结果为基础进行分组，对筛选顺序敏感。&#10;此筛选器在【相同哈希值】前和后有不同的分组显示效果：在前面时是在相同文件夹组中再细分显示相同哈希值组，反之同理。&#10;多数情况下建议将其放在紧接着【相同哈希值】筛选器的前面或后面。"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:CardControl.Header>
        </wpfui:CardControl>
    </StackPanel>
</UserControl>
