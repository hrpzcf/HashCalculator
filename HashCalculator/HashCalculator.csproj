<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <ProjectGuid>{16B60D29-4D81-4360-814C-1A0FFFF5D75B}</ProjectGuid>
        <RootNamespace>HashCalculator</RootNamespace>
        <AssemblyName>HashCalculator</AssemblyName>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Images\icon.ico</ApplicationIcon>
        <StartupObject>HashCalculator.App</StartupObject>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Platforms>x86;x64</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
        <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Images\icon.ico" />
        <Resource Include="Images\loading.gif" />
        <Resource Include="IconFont\iconfont.ttf" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="LibraryFiles\HashCalculator.dll" />
        <EmbeddedResource Include="LibraryFiles\HashCalculator32.dll" />
    </ItemGroup>

    <!--
        第三方组件许可全文：除 WPF UI（NuGet 包）外均直接链接上游许可文件，
        避免在仓库中维护副本。LogicalName 统一为 LICENSE.{组件名}，资源名在程序集内必须唯一。
        Link 只影响 VS 解决方案资源管理器中的显示位置，不会复制文件。
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\OpenHashLibs\Blake2\Blake2\COPYING"
                          Link="Licenses\BLAKE2.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.blake2" />
        <EmbeddedResource Include="..\OpenHashLibs\Blake3\Blake3\LICENSE_CC0"
                          Link="Licenses\BLAKE3.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.blake3" />
        <EmbeddedResource Include="..\OpenHashLibs\CRC32\CRC32\LICENSE"
                          Link="Licenses\CRC32.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.crc32" />
        <EmbeddedResource Include="..\OpenHashLibs\SM3\GmSSL\LICENSE"
                          Link="Licenses\GmSSL.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.gmssl" />
        <EmbeddedResource Include="..\OpenHashLibs\QuickXor\QuickXorHash\LICENSE"
                          Link="Licenses\QuickXorHash.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.quickxorhash" />
        <EmbeddedResource Include="..\OpenHashLibs\RHash\RHash\COPYING"
                          Link="Licenses\RHash.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.rhash" />
        <EmbeddedResource Include="..\OpenHashLibs\Streebog\Streebog\LICENSE"
                          Link="Licenses\Streebog.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.streebog" />
        <EmbeddedResource Include="..\OpenHashLibs\Keccak\XKCP\LICENSE"
                          Link="Licenses\XKCP.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.xkcp" />
        <EmbeddedResource Include="..\OpenHashLibs\XxHash\xxHash\LICENSE"
                          Link="Licenses\xxHash.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.xxhash" />
        <EmbeddedResource Include="..\OpenHashLibs\CRC64\xz-embedded\COPYING"
                          Link="Licenses\xz-embedded.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.xzembedded" />
        <EmbeddedResource Include="..\ShellExtensions\TinyJson\LICENSE"
                          Link="Licenses\Tiny-json.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.tinyjson" />
        <EmbeddedResource Include="Licenses\WpfUi.txt"
                          LogicalName="HashCalculator.Licenses.LICENSE.wpfui" />
    </ItemGroup>

    <ItemGroup Condition="'$(Platform)' == 'x64'">
        <None Include="LibraryFiles\hashalgs_x64.dll" TargetPath="hashalgs.dll">
            <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
            <CopyToPublishDirectory>IfDifferent</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup Condition="'$(Platform)' == 'x86'">
        <None Include="LibraryFiles\hashalgs_x86.dll" TargetPath="hashalgs.dll">
            <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
            <CopyToPublishDirectory>IfDifferent</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="IconFont\demo.css" />
        <None Include="IconFont\demo_index.html" />
        <None Include="IconFont\iconfont.css" />
        <None Include="IconFont\iconfont.js" />
        <None Include="IconFont\iconfont.json" />
    </ItemGroup>

    <Target Name="RenamePublishedExe" AfterTargets="Publish" Condition="'$(PublishProtocol)' != ''">
        <GetAssemblyIdentity AssemblyFiles="$(TargetDir)$(AssemblyName).dll">
            <Output TaskParameter="Assemblies" ItemName="_AsmIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <_LongVersion>@(_AsmIdentity->'%(Version)')</_LongVersion>
            <!-- 取版本号前 3 段，第 4 段不为 0 时追加 -previewN -->
            <_ShortVer>$(_LongVersion.Split('.')[0]).$(_LongVersion.Split('.')[1]).$(_LongVersion.Split('.')[2])</_ShortVer>
            <_Revision>$(_LongVersion.Split('.')[3])</_Revision>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_Revision)' == '0'">
            <_FileNameVersionString>$(_ShortVer)</_FileNameVersionString>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_Revision)' != '0'">
            <_FileNameVersionString>$(_ShortVer)-preview$(_Revision)</_FileNameVersionString>
        </PropertyGroup>
        <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName)-$(Platform)-$(_FileNameVersionString).exe" OverwriteReadOnlyFiles="true" />
    </Target>
</Project>
