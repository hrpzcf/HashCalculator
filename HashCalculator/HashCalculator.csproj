<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <ProjectGuid>{16B60D29-4D81-4360-814C-1A0FFFF5D75B}</ProjectGuid>
        <RootNamespace>HashCalculator</RootNamespace>
        <AssemblyName>HashCalculator</AssemblyName>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Images\icon.ico</ApplicationIcon>
        <StartupObject>HashCalculator.App</StartupObject>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Platforms>x86;x64</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="WindowsAPICodePack-Core" Version="1.1.2" NoWarn="NU1701" />
        <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" NoWarn="NU1701" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
        <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Images\icon.ico" />
        <Resource Include="Images\loading.gif" />
        <Resource Include="IconFont\iconfont.ttf" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="LibraryFiles\HashCalculator.dll" />
        <EmbeddedResource Include="LibraryFiles\HashCalculator32.dll" />
    </ItemGroup>

    <ItemGroup Condition="'$(Platform)' == 'x64'">
        <None Include="LibraryFiles\hashalgs_x64.dll" TargetPath="hashalgs.dll">
            <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
            <CopyToPublishDirectory>IfDifferent</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup Condition="'$(Platform)' == 'x86'">
        <None Include="LibraryFiles\hashalgs_x86.dll" TargetPath="hashalgs.dll">
            <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
            <CopyToPublishDirectory>IfDifferent</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="IconFont\demo.css" />
        <None Include="IconFont\demo_index.html" />
        <None Include="IconFont\iconfont.css" />
        <None Include="IconFont\iconfont.js" />
        <None Include="IconFont\iconfont.json" />
    </ItemGroup>

    <Target Name="RenamePublishedExe" AfterTargets="Publish" Condition="'$(PublishProtocol)' != ''">
        <GetAssemblyIdentity AssemblyFiles="$(TargetDir)$(AssemblyName).dll">
            <Output TaskParameter="Assemblies" ItemName="_AsmIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <_LongVersion>@(_AsmIdentity->'%(Version)')</_LongVersion>
            <!-- 取版本号前 3 段，第 4 段不为 0 时追加 -previewN -->
            <_ShortVer>$(_LongVersion.Split('.')[0]).$(_LongVersion.Split('.')[1]).$(_LongVersion.Split('.')[2])</_ShortVer>
            <_Revision>$(_LongVersion.Split('.')[3])</_Revision>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_Revision)' == '0'">
            <_FileNameVersionString>$(_ShortVer)</_FileNameVersionString>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_Revision)' != '0'">
            <_FileNameVersionString>$(_ShortVer)-preview$(_Revision)</_FileNameVersionString>
        </PropertyGroup>
        <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName)-$(Platform)-$(_FileNameVersionString).exe" OverwriteReadOnlyFiles="true" />
    </Target>
</Project>
