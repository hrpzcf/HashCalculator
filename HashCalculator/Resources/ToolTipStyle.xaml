<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        基于 wpfui 默认 ToolTip 样式，仅覆盖以下三项：
        1. MaxWidth 从 260 加宽到 450。
        2. TextAlignment 从 Justify 改为 Left。
        3. 重写 Template，将 TextBlock.TextWrapping 从 WrapWithOverflow 改为 Wrap。
        
        阴影参数参考 wpfui 默认值（BlurRadius=10、ShadowDepth=5、Opacity=0.135、Color=#202020）。
        阴影改为冻结的资源（o:Freeze），并去掉 EffectThicknessDecorator，
        根元素直接用 Border（Margin 对应 wpfui 装饰器的 Thickness=15）引用冻结的 Effect，
        避免非 100% DPI 下因装饰器非整数 Margin 导致的内容模糊。
    -->
    <DropShadowEffect
        x:Key="ToolTipDropShadow"
        o:Freeze="True"
        BlurRadius="10"
        Direction="270"
        Opacity=".135"
        ShadowDepth="5"
        Color="#202020" />

    <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="{x:Type ToolTip}">
        <Setter Property="MaxWidth" Value="450" />
        <Setter Property="TextBlock.TextAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Name="Border"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        Margin="16"
                        Padding="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Effect="{StaticResource ToolTipDropShadow}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
