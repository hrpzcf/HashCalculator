<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        菜单项统一样式：在 wpfui 的 UiMenuItem 基础上加大文字与高亮块之间的左右间距。
        注意：给菜单显式设置了 ItemContainerStyle 的地方，生成的子项不会自动继承隐式样式，
        需要在自己的 Style 上写 BasedOn="{StaticResource HashCtxMenuItem}"。
    -->
    <Style
        x:Key="HashCtxMenuItem"
        BasedOn="{StaticResource UiMenuItem}"
        TargetType="{x:Type MenuItem}">
        <!--
            菜单项模板里文字到高亮块的内边距是硬编码的（Grid Margin 左右 8），且没有绑定
            Padding，Style 里设 Padding 无效，因此这里用 HeaderTemplate 给文字再叠加一段
            左右外边距（文字所在列为 * 且有拉伸，右侧必须显式加上才能与左侧对称）；
            高亮块本身仍紧贴菜单边框。
        -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Margin="6,0,8,0" Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        覆盖 wpfui 的隐式 MenuItem 样式，使 XAML 里手写的菜单项直接共享上面这份样式。
        作用范围是普通 MenuItem；主窗口菜单栏用的是 wpfui:MenuItem，隐式样式键不同，不受影响。
    -->
    <Style
        x:Key="{x:Type MenuItem}"
        BasedOn="{StaticResource HashCtxMenuItem}"
        TargetType="{x:Type MenuItem}" />

    <!--
        基于 wpfui 默认 ContextMenu 样式（UiContextMenu），仅将 EffectThicknessDecorator 的
        Thickness 从 30 改为 32（4 的倍数），避免非 100% DPI 下装饰器非整数 Margin
        导致内容重采样模糊。保留装饰器结构（定位正确，官方已验证）。
    -->
    <Style
        x:Key="FixedUiContextMenu"
        BasedOn="{StaticResource UiContextMenu}"
        TargetType="{x:Type ContextMenu}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <wpfui:EffectThicknessDecorator Thickness="32">
                        <Border
                            x:Name="Border"
                            Padding="0,3,0,3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.135"
                                    ShadowDepth="10"
                                    Color="#202020" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <StackPanel
                                ClipToBounds="True"
                                IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                Orientation="Vertical" />
                        </Border>
                    </wpfui:EffectThicknessDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Border"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                            From="-90"
                                            To="0"
                                            Duration="00:00:00.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  覆盖默认 ContextMenu 样式，使其应用上述修复  -->
    <Style BasedOn="{StaticResource FixedUiContextMenu}" TargetType="{x:Type ContextMenu}" />

</ResourceDictionary>
