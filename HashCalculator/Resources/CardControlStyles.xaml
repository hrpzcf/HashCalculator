<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        继承 wpfui 的默认 CardControl 样式，仅在鼠标悬浮时改变卡片背景色，
        实现明显的悬浮高亮效果（不包含按下/Pressed 效果，也不改动边框）。
        背景使用各主题自定义的 CardControlMouseHoverBackground（见 Themes/LightOverrides.xaml、
        Themes/DarkOverrides.xaml，由 ThemeOverridesManager 按主题动态加载）。
    -->
    <Style BasedOn="{StaticResource DefaultUiCardControlStyle}" TargetType="{x:Type wpfui:CardControl}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardControlMouseHoverBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        给 CardExpander 加上与 CardControl 相同的悬浮背景色效果。
        模板头部 Border（ToggleButtonBorder）使用 {TemplateBinding Background}，
        故悬浮时改 Background 会反映到头部背景；展开内容区使用 CardBackground，
        不随悬浮变化，符合仅头部反馈的预期。
    -->
    <Style BasedOn="{StaticResource DefaultUiCardExpanderStyle}" TargetType="{x:Type wpfui:CardExpander}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardControlMouseHoverBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        继承 wpfui 的默认 Anchor（HyperlinkButton）样式。
        Button 模板内部已通过 IsMouseOver + IsPressed 触发器把 ContentBorder 背景
        绑定到 MouseOverBackground 属性，因此这里只需直接设置 MouseOverBackground，
        即可实现悬浮背景色变化，无需再写 Trigger。
        背景使用各主题自定义的 AnchorMouseOverBackground（见 Themes/LightOverrides.xaml、
        Themes/DarkOverrides.xaml，由 ThemeOverridesManager 按主题动态加载）。
    -->
    <Style BasedOn="{StaticResource DefaultUiAnchorStyle}" TargetType="{x:Type wpfui:Anchor}">
        <Setter Property="PressedBackground" Value="{DynamicResource AnchorPressedBackground}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource AnchorMouseOverBackground}" />
    </Style>

</ResourceDictionary>
